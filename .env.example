# ============================================================
# WebObsidian — copy to .env and edit, then `docker compose up -d --build`
#   cp .env.example .env
# .env is git-ignored, so your settings survive `git pull` / redeploys.
# ============================================================

# --- Docker deploy (docker compose) -------------------------
# Host path to your vault, bind-mounted to /vault inside the container.
# Absolute path, or relative to this compose file. The directory MUST exist.
# Defaults to the bundled ./sample-vault so the stack boots out of the box.
VAULT_HOST_PATH=./sample-vault

# Where to publish the web UI. Set HTTP_BIND=127.0.0.1 to expose only to
# localhost (e.g. behind an nginx/Caddy reverse proxy with TLS).
HTTP_BIND=0.0.0.0
HTTP_PORT=8787

# Proxy trust. Default "true" (trust the immediate hop) so X-Forwarded-Proto-based
# HTTPS cookie detection works behind a TLS-terminating reverse proxy out of the
# box. This is NOT a rate-limit risk: the login limiter keys on the real TCP socket
# address, not X-Forwarded-For, so it can't be bypassed by spoofing that header.
# Accepts "true"/hop count/subnet list (e.g. "loopback, 10.0.0.0/8"). Set "false"
# only for an instance exposed directly to clients with no reverse proxy.
TRUST_PROXY=true

# Initial master password. Leave empty to set it on first-run via the UI.
WEBOBSIDIAN_PASSWORD=

# File-watch mode:
#   auto    (default) native inotify, auto-falls back to polling if the host's
#           inotify watch limit is exceeded by a large vault.
#   polling force polling (no inotify; works anywhere, higher CPU).
# For large vaults, prefer raising the host limit over polling:
#   sudo sysctl -w fs.inotify.max_user_watches=524288
WEBOBSIDIAN_WATCH=auto

# --- Vault in a GitHub repository (instead of a folder on disk) ---------------
# Set at least REPO and TOKEN and the container starts straight into that
# repository — nothing is cloned. Every variable below overrides settings.json and
# is greyed out in Settings → Storage; unset ones stay editable in the UI. A
# malformed value stops the server at startup and names the variable.
#
# WEBOBSIDIAN_GITHUB_REPO=owner/repo        # or a GitHub URL; implies WEBOBSIDIAN_STORAGE=github
# WEBOBSIDIAN_GITHUB_TOKEN=github_pat_...   # fine-grained, this repo only, Contents: Read and write
# WEBOBSIDIAN_STORAGE=github                # github | local (explicit; local wins over REPO)
# WEBOBSIDIAN_GITHUB_BRANCH=                # empty = default branch (use a test branch while trying it out!)
# WEBOBSIDIAN_GITHUB_BASE_PATH=docs         # subfolder used as the vault root; empty = repo root
# WEBOBSIDIAN_GITHUB_API_URL=               # GitHub Enterprise Server only, e.g. https://ghe.example.com/api/v3
# WEBOBSIDIAN_GITHUB_FLUSH_SEC=15           # seconds without edits before they are committed in one commit
# WEBOBSIDIAN_GITHUB_HOLD_SEC=300          # plugins/app settings (.obsidian/**) are saved after this many quiet seconds
# WEBOBSIDIAN_GITHUB_HOLD_MATCH=.obsidian/** # what counts as held (';'-separated globs, or 'none'); notes are never held
# WEBOBSIDIAN_GITHUB_POLL_SEC=30            # how often to look for commits made elsewhere (min 5)
# Several vaults in one server (each browser tab picks its own; folders and GitHub repos can be mixed).
# A JSON array; every entry: id (a-z0-9-), name, and either path (local folder inside ALLOWED_ROOTS) or repo ("owner/repo").
# Optional per entry: branch, basePath, tokenEnv (name of the variable holding that repo's token), preset|rules, flushSec, holdSec, pollSec, apiUrl.
# Vaults set here are read-only in Settings → Vaults. The main vault is still configured by VAULT_PATH / the variables above.
# WEBOBSIDIAN_VAULTS=[{"id":"work","name":"Work","path":"/data/work"},{"id":"kb","name":"Knowledge base","repo":"acme/kb","tokenEnv":"KB_TOKEN","preset":"mirror-all"}]
# KB_TOKEN=
# WEBOBSIDIAN_GIT_AUTHOR_NAME=              # commit author; default = the owner of the token
# WEBOBSIDIAN_GIT_AUTHOR_EMAIL=
#
# What stays on the server. A preset: default | remote-only | mirror-all
#   default      notes mirrored + searchable, everything else fetched when opened
#   remote-only  nothing is kept on the server (slower; no search/backlinks)
#   mirror-all   download the whole vault
# WEBOBSIDIAN_STORAGE_PRESET=default
# ...or explicit rules, first match wins:  pattern=mode[:index|:noindex]  separated by ';'
#   modes: mirror (kept, prefetched) | lazy (fetched when opened, LRU cache) | remote (never kept)
# WEBOBSIDIAN_STORAGE_RULES=.obsidian/**=mirror:noindex;**/*.{md,canvas}=mirror:index;Private/**=remote;**=lazy
# (a JSON array of {"match","mode","index"} works too; RULES beats PRESET)
#
# WEBOBSIDIAN_CACHE=memory                  # memory (nothing written to disk) | disk
# WEBOBSIDIAN_CACHE_DIR=                    # default <DATA_DIR>/cache
# WEBOBSIDIAN_CACHE_MAX_MB=256

# --- Bare-metal only (npm run start, without docker) --------
# The container sets these itself; uncomment only when running outside docker.
# PORT=8787
# HOST=0.0.0.0
# VAULT_PATH=./sample-vault
# DATA_DIR=./data
# ALLOWED_ROOTS=
# NODE_ENV=production

# Some community plugins (e.g. Excalidraw) evaluate strings and need 'unsafe-eval' in the CSP.
# Off by default because it weakens XSS protection; set to 1 only if you trust the plugins you install.
# WEBOBSIDIAN_ALLOW_UNSAFE_EVAL=1

# Where the community-plugin compatibility list is downloaded from (Settings → Community Plugins → Browse).
# It is produced daily by the webobsidian-community-plugins repository (https://github.com/Pushkinmazila2/webobsidian-community-plugins). Change it to use your own fork.
# WEBOBSIDIAN_PLUGIN_CATALOG_URL=https://raw.githubusercontent.com/Pushkinmazila2/webobsidian-community-plugins/main/community-plugins.json
